# Server-only. Never commit a real .env file (it is gitignored).

# Base URL of the Neon Data API for this project's branch (PostgREST-style REST endpoint).
# Not a secret by itself (security comes from RLS, not URL secrecy), but kept server-side
# here because only the backend talks to it directly.
NEON_DATA_API_URL=https://ep-example.apirest.us-east-1.aws.neon.tech/your_db/rest/v1

# Postgres connection string. Used ONLY by scripts/migrate.js (one-time schema/RLS setup).
# Never imported by the running server (src/app.js, src/server.js, api/index.js).
DATABASE_URL=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/your_db?sslmode=require

# Local dev port for `npm run dev` (app.listen). Not used on Vercel (serverless).
PORT=4000
