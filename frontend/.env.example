# Public — safe to expose in the built JS bundle. Managed Better Auth is a hosted REST
# service designed to be called straight from the browser; RLS (not URL secrecy) is what
# actually protects data. Named per the assignment's rubric (NEXT_PUBLIC_* is a Next.js
# convention; vite.config.js's envPrefix accepts it here too so the literal name still works).
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-example.neonauth.us-east-1.aws.neon.tech/your_db/auth

# Also public per the assignment, and harmless to expose (same reasoning as above) — but
# this app's frontend does not call it directly. All contacts CRUD is proxied through the
# Express backend's own /api/contacts routes for centralized server-side validation; the
# backend is what talks to the Data API. Kept here for completeness against the rubric.
NEXT_PUBLIC_NEON_DATA_API_URL=https://ep-example.apirest.us-east-1.aws.neon.tech/your_db/rest/v1
