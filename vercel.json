{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "api/index.js"
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": { "type": "service", "service": "backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "type": "service", "service": "frontend" }
    }
  ],
  "env": {
    "NEON_DATA_API_URL": "https://ep-icy-sunset-ark9pqap.apirest.c-4.us-west-2.aws.neon.tech/networking_tracker/rest/v1"
  }
}
