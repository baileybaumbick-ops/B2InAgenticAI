# This is an index of every environment variable the app uses. The real files are
# frontend/.env (public) and backend/.env (server-only) — each has its own .env.example
# with the same variables. Never commit a real .env file (all are gitignored).

# ---- Public (frontend/.env) -------------------------------------------------------
# Safe to expose in the built JS bundle: Managed Better Auth is a hosted REST service
# meant to be called from the browser, and RLS (not URL secrecy) is the real protection.
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-example.neonauth.us-east-1.aws.neon.tech/your_db/auth
NEXT_PUBLIC_NEON_DATA_API_URL=https://ep-example.apirest.us-east-1.aws.neon.tech/your_db/rest/v1

# ---- Server-only (backend/.env) ----------------------------------------------------
# Used by the Express backend to forward each user's own JWT to the Data API.
NEON_DATA_API_URL=https://ep-example.apirest.us-east-1.aws.neon.tech/your_db/rest/v1

# Postgres connection string. Used ONLY by backend/scripts/migrate.js (one-time schema/
# RLS setup) — never imported by the running frontend or backend server.
DATABASE_URL=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/your_db?sslmode=require

# Local dev port for the backend's `npm run dev` (app.listen). Not used on Vercel.
PORT=4000
